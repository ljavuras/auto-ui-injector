{
	"name": "auto-ui-injector",
	"version": "0.0.1",
	"description": "Obsidian plugin to automatically inject UI to notes without altering their source.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "yarn node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "yarn node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@obsidian-typings/obsidian-public-latest": "^6.36.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"packageManager": "yarn@4.18.0",
	"allowScripts": {
		"esbuild@0.25.5": true
	},
	"dependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"monkey-around": "^3.0.0",
		"zod": "^4.6.5"
	}
}
